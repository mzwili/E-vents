generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { CUSTOMER ADMIN STAFF }
enum ServiceCategory { CATERING DECOR PACKAGE }
enum BookingStatus { ENQUIRY_RECEIVED QUOTED CONFIRMED IN_PROGRESS COMPLETED CANCELLED }
enum QuoteStatus { DRAFT SENT ACCEPTED DECLINED EXPIRED }
enum PaymentStatus { PENDING SUCCEEDED FAILED REFUNDED }

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
}

model Service {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String
  category       ServiceCategory
  startingPrice  Decimal         @db.Decimal(12, 2)
  currency       String          @default("ZAR")
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookingItems   BookingItem[]
}

model Booking {
  id          String        @id @default(cuid())
  customerId  String
  eventType   String
  eventDate   DateTime
  guestCount  Int
  venue       String
  budget      Decimal?      @db.Decimal(12, 2)
  notes       String?
  status      BookingStatus @default(ENQUIRY_RECEIVED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  customer    User          @relation(fields: [customerId], references: [id])
  items       BookingItem[]
  quotations  Quotation[]
  payments    Payment[]
  @@index([eventDate, status])
  @@index([customerId, createdAt])
}

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  serviceId String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
  booking   Booking @relation(fields: [bookingId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])
}

model Quotation {
  id          String      @id @default(cuid())
  bookingId   String
  version     Int         @default(1)
  status      QuoteStatus @default(DRAFT)
  subtotal    Decimal     @db.Decimal(12, 2)
  tax         Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  validUntil  DateTime?
  createdAt   DateTime    @default(now())
  booking     Booking     @relation(fields: [bookingId], references: [id])
  @@unique([bookingId, version])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  provider          String
  providerReference String?       @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("ZAR")
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  booking           Booking       @relation(fields: [bookingId], references: [id])
}
